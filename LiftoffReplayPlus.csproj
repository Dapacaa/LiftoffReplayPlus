<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LiftoffReplayPlus</AssemblyName>
    <Description>Replay and multiplayer tools for Liftoff</Description>
    <Authors>Dapacaa</Authors>
    <Copyright>Copyright (c) 2026 Dapacaa</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Version>1.5.1</Version>
    <LiftoffDir Condition="'$(LiftoffDir)' == ''">D:\SteamLibrary\steamapps\common\Liftoff</LiftoffDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(LiftoffDir)\Liftoff_Data\Managed</GameManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == '' And Exists('$(LiftoffDir)\BepInEx\core')">$(LiftoffDir)\BepInEx\core</BepInExCoreDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(LiftoffDir)\BepInEx_\core</BepInExCoreDir>
  </PropertyGroup>

  <Target Name="ValidateLiftoffReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')"
           Text="BepInEx.dll was not found. Set LiftoffDir to your Liftoff installation directory." />
    <Error Condition="!Exists('$(BepInExCoreDir)\0Harmony.dll')"
           Text="0Harmony.dll was not found. Set LiftoffDir to your Liftoff installation directory." />
    <Error Condition="!Exists('$(GameManagedDir)\Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll was not found. Set LiftoffDir to your Liftoff installation directory." />
  </Target>

  <ItemGroup>
    <!-- BepInEx Core Reference -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- The Harmony library for patching -->
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Core References -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Legacy Input (keyboard and mouse) -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- IMGUI, which draws all of the mod's windows -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity UI module for Canvas access -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity UI for Slider component -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Text Rendering for TextAnchor -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- The game's own code -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Steamworks.NET (workshop subscribe/download for MP tracks) -->
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Photon PUN2 (multiplayer rooms, pilots and the lobby browser) -->
    <Reference Include="Photon3Unity3D">
      <HintPath>$(GameManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(GameManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Rewired (the game's input system) for freecam input suppression -->
    <Reference Include="Rewired_Core">
      <HintPath>$(GameManagedDir)\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
